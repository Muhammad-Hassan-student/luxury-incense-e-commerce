{
  "name": "e-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "test:orders": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/order-lifecycle.ts",
    "predev": "node scripts/ensure-db.mjs",
    "db:ensure": "node scripts/ensure-db.mjs",
    "test:rbac": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/rbac-check.ts",
    "test:inventory": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/inventory-check.ts",
    "test:customers": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/customer-check.ts",
    "test:reports": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/reports-check.ts",
    "test:all": "vitest run && npm run -s test:orders && npm run -s test:rbac && npm run -s test:inventory && npm run -s test:customers && npm run -s test:visits && npm run -s test:trade && npm run -s test:reports && npm run -s test:returns",
    "test:visits": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/visit-check.ts",
    "test:trade": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/trade-check.ts",
    "test:returns": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/returns-check.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "postprocessing": "^6.39.5",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
