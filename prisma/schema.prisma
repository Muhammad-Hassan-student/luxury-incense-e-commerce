// Maison Oud — data model.
// Money is always stored as integer minor units (paise/cents) in the store's base currency.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Auth ───────────────────────────────

enum Role {
  CUSTOMER
  SUPPORT
  MANAGER
  OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  loyaltyPoints Int       @default(0)
  referralCode  String    @unique @default(cuid())
  referredById  String?
  /// Custom staff role. When set, its permissions replace the defaults for `role` (OWNER always has everything).
  staffRoleId   String?
  lastSeenAt    DateTime?
  /// Set when the customer asks for account deletion; personal data is scrubbed by the cron job.
  deletionRequestedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staffRole     StaffRole?      @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  referredBy    User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]          @relation("Referrals")
  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  wishlist      WishlistItem[]
  subscriptions Subscription[]
  loyaltyLedger LoyaltyEntry[]
  auditLogs     AuditLog[]
  purchaseOrders PurchaseOrder[]
  stockTakes    StockTake[]
  tradeAccount  TradeAccount?
  visits        Visit[]
  returns       ReturnRequest[]
  // Customer journeys (marketing automation)
  journeyEnrollments JourneyEnrollment[]
  journeyMessages    JourneyMessage[]
  customerSegment    CustomerSegment?
  // Sign-in security: second step (Face ID / phone lock)
  securitySettings   SecuritySettings?
  sessionSecondSteps SessionSecondStep[]
  passkeys           Passkey[]
  faceTemplates      FaceTemplate[]
  securityEmailCodes SecurityEmailCode[]
  securityTickets    SecurityTicket[]
  webauthnChallenges WebAuthnChallenge[]
  enrollmentLinks    EnrollmentLink[]
}

/// Named bundle of permissions (see src/lib/permissions.ts). System roles mirror the built-in levels.
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sign-in security: pending/verified second-step marker (separate table, see SessionSecondStep)
  secondStep   SessionSecondStep?
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── Catalog ───────────────────────────────

/// Which ambient animation and procedural 3D model a category/product uses.
enum Ambient {
  SMOKE
  FLAME
  RIPPLE
  GLOW
  UNBOX
}

enum Model3D {
  INCENSE
  DHOOP
  CANDLE
  OIL
  BAKHOOR
  GIFTBOX
  CARD
  COIL
  PERFUME
  OUD
}

enum ScentFamily {
  WOODY
  ORIENTAL
  FLORAL
  FRESH
  SPICY
  RESINOUS
  GOURMAND
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  tagline     String
  description String
  ambient     Ambient
  accent      String     @default("#B8945A")
  position    Int        @default(0)
  /// Optional banner media; the ambient animation is used when both are empty.
  heroImage   String?
  heroVideo   String?
  products    Product[]
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String
  featured    Boolean             @default(false)
  position    Int                 @default(0)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  subtitle     String
  story        String
  categoryId   String
  family       ScentFamily
  intensity    Int           @default(3) /// 1–5
  burnTime     String?       /// e.g. "45 min per stick"
  origin       String?
  model        Model3D
  /// Visual palette for procedural renders: [primary, secondary]
  palette      String[]
  topNotes     String[]
  heartNotes   String[]
  baseNotes    String[]
  moods        String[]      /// quiz tags: calm, focus, romance, celebration, sleep…
  timeOfDay    String[]      /// morning, evening, night
  isFeatured   Boolean       @default(false)
  isBestseller Boolean       @default(false)
  isActive     Boolean       @default(true)
  /// Digital gift card: no shipping, tax or discounts; issues GiftCard codes when paid.
  isGiftCard   Boolean       @default(false)
  ratingAvg    Float         @default(0)
  ratingCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category     Category            @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  collections  CollectionProduct[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  stockAlerts  StockAlert[]

  @@index([categoryId, isActive])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  label          String   /// "40 sticks", "50 ml", "Large"
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  reserved       Int      @default(0)
  weightGrams    Int      @default(100)
  position       Int      @default(0)
  /// Landed cost per unit (minor units), for margins and stock valuation
  costPrice      Int?
  /// Reorder when available stock falls to this level (null = store default)
  reorderPoint   Int?
  /// Suggested quantity to order when reordering
  reorderQty     Int?
  barcode        String?  @unique
  /// Wholesale: units per case (trade orders must be multiples) and minimum trade quantity
  caseSize       Int      @default(1)
  tradeMinQty    Int      @default(1)
  tradeEnabled   Boolean  @default(true)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  purchaseItems  PurchaseOrderItem[]
  tradePrices    TradePrice[]
  quoteItems     QuoteItem[]
  stockTakeLines StockTakeLine[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryLogs  InventoryLog[]
  subscriptions  Subscription[]
}

enum MediaType {
  IMAGE
  VIDEO
}

/// How a photo sits in the storefront: AUTO uses the studio cutout when one could be made.
enum ImageDisplay {
  AUTO
  CUTOUT
  PHOTO
}

/// Optional photos and videos. Products without media fall back to procedural art and the 3D model.
model ProductImage {
  id        String    @id @default(cuid())
  productId String
  type      MediaType @default(IMAGE)
  url       String
  /// Still frame shown before a video plays
  poster    String?
  /// Background-removed version (made automatically for plain-background product shots)
  cutoutUrl String?
  display   ImageDisplay @default(AUTO)
  /// Average colour of the photo's border, used to tint its frame
  edgeColor String?
  width     Int?
  height    Int?
  alt       String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  delta     Int
  reason    String /// RESERVE, RELEASE, SALE, RESTOCK, ADJUST, RETURN
  orderId   String?
  actorId   String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
}

// ─────────────────────────────── Cart ───────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  /// Guest carts are keyed by an httpOnly cookie token.
  token     String     @unique @default(cuid())
  couponId  String?
  giftWrap  Boolean    @default(false)
  giftNote  String?
  /// Gift card code applied as tender at checkout
  giftCardCode String?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  /// Abandoned cart email sent at
  remindedAt DateTime?
  email     String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  /// Gift box builder contents, stored as JSON when variant is a custom box
  bundle    Json?
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─────────────────────────────── Orders & payments ───────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  COD
  /// Trade accounts on credit terms: confirmed now, paid by the invoice due date
  INVOICE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique /// human friendly: MO-24001
  userId          String?
  email           String
  status          OrderStatus @default(PENDING)
  currency        String
  subtotal        Int
  discount        Int         @default(0)
  pointsRedeemed  Int         @default(0)
  shipping        Int
  tax             Int
  total           Int
  couponCode      String?
  /// Gift card used as tender; its balance is held at placement and restored on cancel/refund.
  giftCardCode    String?
  giftCardAmount  Int         @default(0)
  giftWrap        Boolean     @default(false)
  giftNote        String?
  deliveryDate    DateTime?
  shippingAddress Json
  trackingNumber  String?
  carrier         String?
  notes           String?
  reservedUntil   DateTime?
  /// Trade (wholesale) orders
  tradeAccountId  String?
  poNumber        String? /// buyer's own purchase-order reference
  dueDate         DateTime? /// invoice due date for orders on credit terms
  paidAt          DateTime?
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User?        @relation(fields: [userId], references: [id])
  tradeAccount TradeAccount? @relation(fields: [tradeAccountId], references: [id])
  quote    Quote?
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]
  returns  ReturnRequest[]

  // ── WhatsApp, COD verification & RTO risk ──
  /// Cash-on-delivery verification. null = not COD. AWAITING orders must not be packed (see src/server/cod.ts).
  codStatus        CodStatus?
  codConfirmedAt   DateTime?
  /// whatsapp | link | email | staff | auto
  codConfirmedVia  String?
  /// Auto-cancelled if still AWAITING at this time
  codConfirmBy     DateTime?
  codReminderSentAt DateTime?
  /// sha256 of the single-use web confirmation link nonce (cleared once used)
  codTokenHash     String?    @unique
  /// RTO risk 0–100 with explained reasons [{ code, label, points }]
  riskScore        Int?
  riskReasons      Json?
  /// Customer ticked "Get order updates on WhatsApp" at checkout
  whatsappOptIn    Boolean    @default(false)
  whatsappMessages WhatsAppMessage[]

  // ── Courier & fulfilment (src/server/courier/**) ──
  /// Set when the courier starts returning the parcel to us (RTO). The board lists it under Exceptions.
  rtoAt            DateTime?
  shipments        Shipment[]

  @@index([codStatus, codConfirmBy])
  @@index([status, placedAt])
  @@index([userId])
  @@index([tradeAccountId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  /// Snapshot so later catalog edits never change history
  name      String
  label     String
  sku       String
  unitPrice Int
  quantity  Int
  image     String?
  /// Variant ids of coffret pieces (stock moves with the line)
  components String[]       @default([])
  /// Gift card purchase details: { recipientName, recipientEmail, message, senderName }
  meta      Json?
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  message   String
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  status      PaymentStatus   @default(CREATED)
  amount      Int
  currency    String
  providerRef String?         @unique /// Stripe PaymentIntent / Razorpay order id
  raw         Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Idempotency for payment webhooks: a replayed event id is ignored.
model WebhookEvent {
  id         String   @id /// provider event id
  provider   String
  receivedAt DateTime @default(now())
}

// ─────────────────────────────── Promotions & loyalty ───────────────────────────────

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Int /// percent (0-100) or minor units
  minSubtotal Int          @default(0)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  carts       Cart[]
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  initial        Int
  balance        Int
  recipient      String?
  recipientEmail String?
  senderName     String?
  message        String?
  isActive       Boolean   @default(true)
  /// Order that purchased it (null when issued by staff)
  sourceOrderId  String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sourceOrderId])
}

model LoyaltyEntry {
  id        String   @id @default(cuid())
  userId    String
  points    Int /// positive = earned, negative = redeemed
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  variantId    String
  quantity     Int                @default(1)
  intervalDays Int                @default(30)
  status       SubscriptionStatus @default(ACTIVE)
  nextRunAt    DateTime
  providerRef  String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id])

  // ── Subscribe & Save (src/server/subscriptions.ts) ──
  /// Every 1, 2 or 3 months (intervalDays is kept ≈ months × 30 for older readers)
  intervalMonths   Int              @default(1)
  /// Discount locked in at sign-up
  discountPercent  Int              @default(0)
  provider         PaymentProvider?
  email            String           @default("")
  shippingAddress  Json?
  shippingRateId   String?
  /// The paid checkout order that started it
  originOrderId    String?
  /// Stripe customer + saved card for off-session renewals
  customerRef      String?
  paymentMethodRef String?
  /// Consecutive failed renewals; pauses itself at the configured maximum
  failureCount     Int              @default(0)
  retryAt          DateTime?
  lastError        String?
  pausedAt         DateTime?
  /// customer | staff | payment_failed
  pauseReason      String?
  cancelledAt      DateTime?
  /// nextRunAt the "renews soon" reminder was sent for
  reminderFor      DateTime?
  renewals         SubscriptionRenewal[]

  @@unique([originOrderId, variantId])
  @@index([status, nextRunAt])
  @@index([userId])
}

enum RenewalStatus {
  PENDING
  PAID
  FAILED
  SKIPPED
}

/// One attempt at renewing a subscription for a due date. Unique per (subscription, due date, attempt) so cron reruns never double-bill.
model SubscriptionRenewal {
  id             String        @id @default(cuid())
  subscriptionId String
  dueAt          DateTime
  attempt        Int           @default(1)
  status         RenewalStatus @default(PENDING)
  orderId        String?       @unique
  error          String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, dueAt, attempt])
  @@index([status])
}

// ─────────────────────────────── Engagement ───────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String
  body      String
  photos    String[]
  verified  Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

model JournalPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String /// markdown
  cover       String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────── Store management ───────────────────────────────

/// Homepage & campaign content, editable from /admin/content as ordered typed blocks.
model ContentBlock {
  id        String   @id @default(cuid())
  page      String   @default("home")
  type      String /// hero | collections | featured3d | story | bestsellers | ritual | gifting | journal | newsletter
  position  Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([page, position])
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(true)
  description String
}

/// Single-row store settings (key = "store").
model Setting {
  key   String @id
  value Json
}

model ShippingRate {
  id            String   @id @default(cuid())
  name          String
  countries     String[] /// ISO codes, ["*"] = rest of world
  price         Int
  freeOver      Int?
  etaDays       String
  position      Int      @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

// ─────────────────────────────── Purchasing & stock control ───────────────────────────────

model Supplier {
  id           String          @id @default(cuid())
  name         String          @unique
  contactName  String?
  email        String?
  phone        String?
  leadTimeDays Int             @default(14)
  notes        String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  variants     ProductVariant[]
  orders       PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique /// PO-26001
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  createdById String
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       PurchaseOrderItem[]

  @@index([status])
}

model PurchaseOrderItem {
  id        String         @id @default(cuid())
  poId      String
  variantId String
  quantity  Int
  received  Int            @default(0)
  unitCost  Int /// minor units
  po        PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([poId, variantId])
}

enum StockTakeStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Physical count: snapshot expected stock, enter counts, then apply the differences as adjustments.
model StockTake {
  id          String          @id @default(cuid())
  name        String
  status      StockTakeStatus @default(OPEN)
  note        String?
  createdById String
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  createdBy   User            @relation(fields: [createdById], references: [id])
  lines       StockTakeLine[]
}

model StockTakeLine {
  id          String         @id @default(cuid())
  stockTakeId String
  variantId   String
  expected    Int
  counted     Int?
  stockTake   StockTake      @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([stockTakeId, variantId])
}

// ─────────────────────────────── Trade (wholesale) ───────────────────────────────

enum TradeStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TradeTerms {
  PREPAID
  NET_15
  NET_30
  NET_60
}

/// A business buying to resell (or for hotels, spas, corporate gifting). One per user login.
model TradeAccount {
  id              String      @id @default(cuid())
  userId          String      @unique
  status          TradeStatus @default(PENDING)
  businessName    String
  businessType    String /// RETAILER | DISTRIBUTOR | HOSPITALITY | SPA | CORPORATE | ONLINE | OTHER
  contactName     String
  phone           String
  taxId           String? /// GSTIN / NTN / VAT number
  website         String?
  address         Json
  expectedMonthly String? /// volume band from the application
  message         String?
  tierId          String?
  terms           TradeTerms  @default(PREPAID)
  creditLimit     Int         @default(0) /// minor units; 0 = no credit
  minOrderValue   Int         @default(0) /// overrides the tier minimum when > 0
  staffNotes      String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            PriceTier?  @relation(fields: [tierId], references: [id], onDelete: SetNull)
  orders          Order[]
  quotes          Quote[]

  @@index([status])
}

/// Wholesale price level: a discount off retail, optionally overridden per variant.
model PriceTier {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  discountPercent Int /// off retail price
  minOrderValue   Int            @default(0) /// minor units
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        TradeAccount[]
  prices          TradePrice[]
}

model TradePrice {
  tierId    String
  variantId String
  price     Int /// minor units, per unit
  tier      PriceTier      @relation(fields: [tierId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([tierId, variantId])
}

enum QuoteStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Request for quotation: very large, custom or private-label orders.
model Quote {
  id             String       @id @default(cuid())
  number         String       @unique /// Q-26001
  tradeAccountId String
  status         QuoteStatus  @default(REQUESTED)
  message        String?
  staffNotes     String? /// internal
  replyMessage   String? /// shown to the buyer with the quote
  validUntil     DateTime?
  orderId        String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tradeAccount   TradeAccount @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
}

model QuoteItem {
  id             String          @id @default(cuid())
  quoteId        String
  variantId      String?
  description    String /// product label, or free text for custom/private-label requests
  quantity       Int
  targetPrice    Int? /// buyer's target per unit (minor)
  quotedPrice    Int? /// our price per unit (minor)
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────── Atelier / factory visits ───────────────────────────────

enum VisitStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

model Visit {
  id           String      @id @default(cuid())
  reference    String      @unique /// V-26-0001, printed on the visitor pass
  /// Secret for the visitor's self-service link (view / reschedule / cancel)
  token        String      @unique @default(cuid())
  name         String
  email        String
  phone        String
  company      String?
  purpose      String /// WHOLESALE | CORPORATE | WORKSHOP | PRESS | TOUR | OTHER
  groupSize    Int
  startsAt     DateTime
  durationMins Int         @default(60)
  status       VisitStatus @default(REQUESTED)
  message      String?
  staffNotes   String?
  checkedInAt  DateTime?
  userId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([status])
}

// ─────────────────────────────── Returns & exchanges (RMA) ───────────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  EXCHANGED
  REJECTED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  OPENED
}

/// Customer return / exchange request against a delivered order. Policy lives in Setting "returns".
model ReturnRequest {
  id              String            @id @default(cuid())
  number          String            @unique /// RMA-26001
  orderId         String
  userId          String?
  status          ReturnStatus      @default(REQUESTED)
  reason          String
  customerNote    String?
  /// Internal; never shown to the customer
  staffNote       String?
  /// Shown to (and emailed to) the customer when rejected
  rejectionReason String?
  /// What the customer asked for; staff confirm or change it when resolving
  preferred       ReturnResolution  @default(REFUND)
  resolution      ReturnResolution?
  /// Money value given back (refund or store credit), minor units, after the restocking fee
  refundAmount    Int?
  restockingFee   Int               @default(0)
  /// Part of refundAmount refunded against the original payment (via the provider, or by hand for COD/invoice); the rest went back to the gift card
  providerAmount  Int               @default(0)
  /// PROVIDER | MANUAL | GIFT_CARD | STORE_CREDIT | MIXED
  refundMethod    String?
  /// Store credit issued for this return
  giftCardId      String?           @unique
  /// Zero-value replacement order for exchanges
  exchangeOrderId String?           @unique
  requestedAt     DateTime          @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  receivedAt      DateTime?
  resolvedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           ReturnItem[]

  @@index([status, createdAt])
  @@index([orderId])
  @@index([userId])
}

model ReturnItem {
  id          String           @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  /// Recorded on inspection
  condition   ReturnCondition?
  /// Whether the units went back into sellable stock
  restock     Boolean          @default(false)
  returnReq   ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}

// ─────────────────────────────── Customer journeys (marketing automation) ───────────────────────────────
// Engine: src/server/automations.ts (cron job "journeys"). Everything here belongs to that feature.

enum JourneyEnrollmentStatus {
  ACTIVE
  COMPLETED
  EXITED
  CONVERTED
}

enum JourneyMessageStatus {
  SENDING
  SENT
  FAILED
}

/// A built-in automated flow (welcome, win-back, VIP …). `config` (timing, offers) is validated by zod in code.
model Journey {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  enabled     Boolean             @default(false)
  /// "segment:New", "segment:At risk", "event:delivered" …
  trigger     String
  config      Json
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  enrollments JourneyEnrollment[]
}

/// One customer's run through a journey.
model JourneyEnrollment {
  id               String                  @id @default(cuid())
  journeyId        String
  userId           String
  /// Identity of the entry event (segment entry time, or the delivered order) — one entry can never enroll twice.
  entryKey         String
  status           JourneyEnrollmentStatus @default(ACTIVE)
  /// Index of the next step to run.
  step             Int                     @default(0)
  nextRunAt        DateTime?
  enteredAt        DateTime                @default(now())
  exitedAt         DateTime?
  exitReason       String?
  /// Entry details (segment, order id …).
  context          Json?
  convertedOrderId String?
  updatedAt        DateTime                @updatedAt
  journey          Journey                 @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         JourneyMessage[]

  @@unique([journeyId, userId, entryKey])
  @@index([status, nextRunAt])
  @@index([userId, status])
  @@index([journeyId, enteredAt])
}

/// An email sent by a journey step (with the coupon / points it carried). At most one per enrollment step.
model JourneyMessage {
  id               String               @id @default(cuid())
  enrollmentId     String
  userId           String
  step             Int
  template         String
  email            String
  status           JourneyMessageStatus @default(SENDING)
  sentAt           DateTime             @default(now())
  /// Personal single-use coupon, bound to `email`.
  couponCode       String?              @unique
  couponExpiresAt  DateTime?
  points           Int?
  /// Last-touch attribution: the order placed within the attribution window after this message.
  convertedOrderId String?              @unique
  revenue          Int?
  convertedAt      DateTime?
  error            String?
  enrollment       JourneyEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, step])
  @@index([userId, sentAt])
  @@index([sentAt])
}

/// Last evaluated RFM segment per customer — journeys enroll on changes ("entered At risk").
model CustomerSegment {
  userId    String   @id
  segment   String
  /// When the customer entered this segment.
  since     DateTime
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([segment, since])
}

/// Marketing consent per email address (lower-case). No row = journeys allowed.
model MarketingPreference {
  email     String   @id
  journeys  Boolean  @default(true)
  /// account | link | one-click
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Sign-in security: second step (Face ID / phone lock) ───────────────────────────
// Owned by src/server/security/**. Kept in separate tables so the normal sign-in path never loads them and a deploy
// that runs before this migration keeps working (the lookups fail open only on "table does not exist").

/// Per-user second-step preferences + wrong-try lockout counter.
model SecuritySettings {
  userId            String    @id
  secondStepEnabled Boolean   @default(false)
  phoneLockEnabled  Boolean   @default(true)
  faceEnabled       Boolean   @default(true)
  /// Random WebAuthn user handle (base64url) shared by all of this user's passkeys.
  webauthnUserId    String    @unique
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Marks a database session created by step 1 (magic link / Google) that still needs the second step.
model SessionSecondStep {
  sessionToken String    @id
  userId       String
  /// verify = prove a saved method; setup = the admin policy requires a method and none is saved yet
  mode         String    @default("verify")
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  session      Session   @relation(fields: [sessionToken], references: [sessionToken], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// WebAuthn platform credential ("phone lock"). Only public material is stored.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// base64url credential id
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  name         String
  rpId         String
  backedUp     Boolean   @default(false)
  transports   String[]
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One saved face: an AES-256-GCM encrypted 128-number SFace embedding. Never a photo.
model FaceTemplate {
  id         String    @id @default(cuid())
  userId     String
  label      String
  embedding  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 6-digit code emailed to confirm security changes (only an HMAC is stored).
model SecurityEmailCode {
  id               String    @id @default(cuid())
  userId           String
  /// manage | enroll
  purpose          String
  enrollmentLinkId String?
  codeHash         String
  attempts         Int       @default(0)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Short-lived, single-use permission for one security step (stored hashed).
model SecurityTicket {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  /// signin | manage | enroll
  audience         String
  /// manage tickets: add | disable
  scope            String?
  userId           String
  sessionToken     String?
  enrollmentLinkId String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Server-side WebAuthn challenge, consumed atomically (single use, 5 minutes).
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  ticketId  String
  userId    String
  /// register | authenticate
  kind      String
  rpId      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time link to add another phone or person's face to an account (token stored hashed).
model EnrollmentLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── WhatsApp, COD verification & RTO risk ───────────────────────────

enum CodStatus {
  AWAITING
  CONFIRMED
  CANCELLED
}

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

/// Every WhatsApp message in or out (also in test mode, flagged `test`).
model WhatsAppMessage {
  id          String         @id @default(cuid())
  /// E.164 phone of the customer
  phone       String
  /// out | in
  direction   String         @default("out")
  /// order_confirmed | cod_confirm | cod_reminder | shipped | out_for_delivery | delivered | abandoned_bag | text | inbound
  kind        String
  template    String?
  vars        Json?
  body        String?
  status      WhatsAppStatus @default(QUEUED)
  /// Meta message id (wamid…); inbound ids are unique too, which makes webhook replays idempotent
  waMessageId String?        @unique
  error       String?
  /// Mock mode: recorded, never sent
  test        Boolean        @default(false)
  orderId     String?
  userId      String?
  cartId      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([orderId])
  @@index([cartId])
}

/// WhatsApp consent per phone (E.164). Opt-in at checkout; replying STOP opts out.
model WhatsAppContact {
  phone      String    @id
  optedIn    Boolean   @default(false)
  consentAt  DateTime?
  optedOutAt DateTime?
  /// checkout | reply | admin
  source     String?
  email      String?
  userId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
}

// ─────────────────────────── Courier & fulfilment (Shiprocket) ───────────────────────────
// Owned by src/server/courier/**. Provider "mock" = offline test mode (no Shiprocket credentials).

enum ShipmentStatus {
  CREATED
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RTO
  RTO_DELIVERED
  CANCELLED
  LOST
}

/// One parcel booked with a courier for an order. A cancelled shipment stays (active = false) and a new one may follow.
model Shipment {
  id                 String         @id @default(cuid())
  orderId            String
  /// shiprocket | mock
  provider           String
  active             Boolean        @default(true)
  status             ShipmentStatus @default(CREATED)
  /// Our reference sent to the courier (order number, suffixed on re-booking)
  reference          String         @unique
  providerOrderId    String?
  providerShipmentId String?
  courierId          String?
  courierName        String?
  awb                String?        @unique
  /// Courier-hosted label PDF (live mode). Mock labels are rendered on demand.
  labelUrl           String?
  manifestUrl        String?
  trackUrl           String?
  pickupScheduledAt  DateTime?
  pickupToken        String?
  etd                DateTime?
  /// Freight charged by the courier, minor units
  charges            Int?
  weightGrams        Int
  cod                Boolean        @default(false)
  codAmount          Int            @default(0)
  lastTracking       Json?
  lastSyncedAt       DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  /// Out-for-delivery email sent (once per shipment)
  ofdNotifiedAt      DateTime?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events             ShipmentEvent[]

  @@index([orderId])
  @@index([active, status])
}

/// A courier scan. `dedupeKey` makes webhook replays and polling overlap harmless.
model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  /// Our mapped status, null when the scan doesn't change it (informational)
  status     ShipmentStatus?
  /// Courier's own wording, e.g. "IN TRANSIT", "RTO INITIATED"
  rawStatus  String
  location   String?
  at         DateTime
  /// webhook | poll | system | mock
  source     String         @default("system")
  dedupeKey  String         @unique
  raw        Json?
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, at])
}
