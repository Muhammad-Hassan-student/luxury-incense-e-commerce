// Maison Oud — data model.
// Money is always stored as integer minor units (paise/cents) in the store's base currency.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Auth ───────────────────────────────

enum Role {
  CUSTOMER
  SUPPORT
  MANAGER
  OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  loyaltyPoints Int       @default(0)
  referralCode  String    @unique @default(cuid())
  referredById  String?
  /// Custom staff role. When set, its permissions replace the defaults for `role` (OWNER always has everything).
  staffRoleId   String?
  lastSeenAt    DateTime?
  /// Set when the customer asks for account deletion; personal data is scrubbed by the cron job.
  deletionRequestedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staffRole     StaffRole?      @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  referredBy    User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]          @relation("Referrals")
  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  wishlist      WishlistItem[]
  subscriptions Subscription[]
  loyaltyLedger LoyaltyEntry[]
  auditLogs     AuditLog[]
  purchaseOrders PurchaseOrder[]
  stockTakes    StockTake[]
  tradeAccount  TradeAccount?
  visits        Visit[]
  returns       ReturnRequest[]
}

/// Named bundle of permissions (see src/lib/permissions.ts). System roles mirror the built-in levels.
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── Catalog ───────────────────────────────

/// Which ambient animation and procedural 3D model a category/product uses.
enum Ambient {
  SMOKE
  FLAME
  RIPPLE
  GLOW
  UNBOX
}

enum Model3D {
  INCENSE
  DHOOP
  CANDLE
  OIL
  BAKHOOR
  GIFTBOX
  CARD
}

enum ScentFamily {
  WOODY
  ORIENTAL
  FLORAL
  FRESH
  SPICY
  RESINOUS
  GOURMAND
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  tagline     String
  description String
  ambient     Ambient
  accent      String     @default("#B8945A")
  position    Int        @default(0)
  /// Optional banner media; the ambient animation is used when both are empty.
  heroImage   String?
  heroVideo   String?
  products    Product[]
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String
  featured    Boolean             @default(false)
  position    Int                 @default(0)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  subtitle     String
  story        String
  categoryId   String
  family       ScentFamily
  intensity    Int           @default(3) /// 1–5
  burnTime     String?       /// e.g. "45 min per stick"
  origin       String?
  model        Model3D
  /// Visual palette for procedural renders: [primary, secondary]
  palette      String[]
  topNotes     String[]
  heartNotes   String[]
  baseNotes    String[]
  moods        String[]      /// quiz tags: calm, focus, romance, celebration, sleep…
  timeOfDay    String[]      /// morning, evening, night
  isFeatured   Boolean       @default(false)
  isBestseller Boolean       @default(false)
  isActive     Boolean       @default(true)
  /// Digital gift card: no shipping, tax or discounts; issues GiftCard codes when paid.
  isGiftCard   Boolean       @default(false)
  ratingAvg    Float         @default(0)
  ratingCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category     Category            @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  collections  CollectionProduct[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  stockAlerts  StockAlert[]

  @@index([categoryId, isActive])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  label          String   /// "40 sticks", "50 ml", "Large"
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  reserved       Int      @default(0)
  weightGrams    Int      @default(100)
  position       Int      @default(0)
  /// Landed cost per unit (minor units), for margins and stock valuation
  costPrice      Int?
  /// Reorder when available stock falls to this level (null = store default)
  reorderPoint   Int?
  /// Suggested quantity to order when reordering
  reorderQty     Int?
  barcode        String?  @unique
  /// Wholesale: units per case (trade orders must be multiples) and minimum trade quantity
  caseSize       Int      @default(1)
  tradeMinQty    Int      @default(1)
  tradeEnabled   Boolean  @default(true)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  purchaseItems  PurchaseOrderItem[]
  tradePrices    TradePrice[]
  quoteItems     QuoteItem[]
  stockTakeLines StockTakeLine[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryLogs  InventoryLog[]
  subscriptions  Subscription[]
}

enum MediaType {
  IMAGE
  VIDEO
}

/// How a photo sits in the storefront: AUTO uses the studio cutout when one could be made.
enum ImageDisplay {
  AUTO
  CUTOUT
  PHOTO
}

/// Optional photos and videos. Products without media fall back to procedural art and the 3D model.
model ProductImage {
  id        String    @id @default(cuid())
  productId String
  type      MediaType @default(IMAGE)
  url       String
  /// Still frame shown before a video plays
  poster    String?
  /// Background-removed version (made automatically for plain-background product shots)
  cutoutUrl String?
  display   ImageDisplay @default(AUTO)
  /// Average colour of the photo's border, used to tint its frame
  edgeColor String?
  width     Int?
  height    Int?
  alt       String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  delta     Int
  reason    String /// RESERVE, RELEASE, SALE, RESTOCK, ADJUST, RETURN
  orderId   String?
  actorId   String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
}

// ─────────────────────────────── Cart ───────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  /// Guest carts are keyed by an httpOnly cookie token.
  token     String     @unique @default(cuid())
  couponId  String?
  giftWrap  Boolean    @default(false)
  giftNote  String?
  /// Gift card code applied as tender at checkout
  giftCardCode String?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  /// Abandoned cart email sent at
  remindedAt DateTime?
  email     String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  /// Gift box builder contents, stored as JSON when variant is a custom box
  bundle    Json?
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─────────────────────────────── Orders & payments ───────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  COD
  /// Trade accounts on credit terms: confirmed now, paid by the invoice due date
  INVOICE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique /// human friendly: MO-24001
  userId          String?
  email           String
  status          OrderStatus @default(PENDING)
  currency        String
  subtotal        Int
  discount        Int         @default(0)
  pointsRedeemed  Int         @default(0)
  shipping        Int
  tax             Int
  total           Int
  couponCode      String?
  /// Gift card used as tender; its balance is held at placement and restored on cancel/refund.
  giftCardCode    String?
  giftCardAmount  Int         @default(0)
  giftWrap        Boolean     @default(false)
  giftNote        String?
  deliveryDate    DateTime?
  shippingAddress Json
  trackingNumber  String?
  carrier         String?
  notes           String?
  reservedUntil   DateTime?
  /// Trade (wholesale) orders
  tradeAccountId  String?
  poNumber        String? /// buyer's own purchase-order reference
  dueDate         DateTime? /// invoice due date for orders on credit terms
  paidAt          DateTime?
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User?        @relation(fields: [userId], references: [id])
  tradeAccount TradeAccount? @relation(fields: [tradeAccountId], references: [id])
  quote    Quote?
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]
  returns  ReturnRequest[]

  @@index([status, placedAt])
  @@index([userId])
  @@index([tradeAccountId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  /// Snapshot so later catalog edits never change history
  name      String
  label     String
  sku       String
  unitPrice Int
  quantity  Int
  image     String?
  /// Variant ids of coffret pieces (stock moves with the line)
  components String[]       @default([])
  /// Gift card purchase details: { recipientName, recipientEmail, message, senderName }
  meta      Json?
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  message   String
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  status      PaymentStatus   @default(CREATED)
  amount      Int
  currency    String
  providerRef String?         @unique /// Stripe PaymentIntent / Razorpay order id
  raw         Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Idempotency for payment webhooks: a replayed event id is ignored.
model WebhookEvent {
  id         String   @id /// provider event id
  provider   String
  receivedAt DateTime @default(now())
}

// ─────────────────────────────── Promotions & loyalty ───────────────────────────────

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Int /// percent (0-100) or minor units
  minSubtotal Int          @default(0)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  carts       Cart[]
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  initial        Int
  balance        Int
  recipient      String?
  recipientEmail String?
  senderName     String?
  message        String?
  isActive       Boolean   @default(true)
  /// Order that purchased it (null when issued by staff)
  sourceOrderId  String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sourceOrderId])
}

model LoyaltyEntry {
  id        String   @id @default(cuid())
  userId    String
  points    Int /// positive = earned, negative = redeemed
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  variantId    String
  quantity     Int                @default(1)
  intervalDays Int                @default(30)
  status       SubscriptionStatus @default(ACTIVE)
  nextRunAt    DateTime
  providerRef  String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id])
}

// ─────────────────────────────── Engagement ───────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String
  body      String
  photos    String[]
  verified  Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

model JournalPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String /// markdown
  cover       String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────── Store management ───────────────────────────────

/// Homepage & campaign content, editable from /admin/content as ordered typed blocks.
model ContentBlock {
  id        String   @id @default(cuid())
  page      String   @default("home")
  type      String /// hero | collections | featured3d | story | bestsellers | ritual | gifting | journal | newsletter
  position  Int
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([page, position])
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(true)
  description String
}

/// Single-row store settings (key = "store").
model Setting {
  key   String @id
  value Json
}

model ShippingRate {
  id            String   @id @default(cuid())
  name          String
  countries     String[] /// ISO codes, ["*"] = rest of world
  price         Int
  freeOver      Int?
  etaDays       String
  position      Int      @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

// ─────────────────────────────── Purchasing & stock control ───────────────────────────────

model Supplier {
  id           String          @id @default(cuid())
  name         String          @unique
  contactName  String?
  email        String?
  phone        String?
  leadTimeDays Int             @default(14)
  notes        String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  variants     ProductVariant[]
  orders       PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique /// PO-26001
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  createdById String
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       PurchaseOrderItem[]

  @@index([status])
}

model PurchaseOrderItem {
  id        String         @id @default(cuid())
  poId      String
  variantId String
  quantity  Int
  received  Int            @default(0)
  unitCost  Int /// minor units
  po        PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([poId, variantId])
}

enum StockTakeStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Physical count: snapshot expected stock, enter counts, then apply the differences as adjustments.
model StockTake {
  id          String          @id @default(cuid())
  name        String
  status      StockTakeStatus @default(OPEN)
  note        String?
  createdById String
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  createdBy   User            @relation(fields: [createdById], references: [id])
  lines       StockTakeLine[]
}

model StockTakeLine {
  id          String         @id @default(cuid())
  stockTakeId String
  variantId   String
  expected    Int
  counted     Int?
  stockTake   StockTake      @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([stockTakeId, variantId])
}

// ─────────────────────────────── Trade (wholesale) ───────────────────────────────

enum TradeStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TradeTerms {
  PREPAID
  NET_15
  NET_30
  NET_60
}

/// A business buying to resell (or for hotels, spas, corporate gifting). One per user login.
model TradeAccount {
  id              String      @id @default(cuid())
  userId          String      @unique
  status          TradeStatus @default(PENDING)
  businessName    String
  businessType    String /// RETAILER | DISTRIBUTOR | HOSPITALITY | SPA | CORPORATE | ONLINE | OTHER
  contactName     String
  phone           String
  taxId           String? /// GSTIN / NTN / VAT number
  website         String?
  address         Json
  expectedMonthly String? /// volume band from the application
  message         String?
  tierId          String?
  terms           TradeTerms  @default(PREPAID)
  creditLimit     Int         @default(0) /// minor units; 0 = no credit
  minOrderValue   Int         @default(0) /// overrides the tier minimum when > 0
  staffNotes      String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            PriceTier?  @relation(fields: [tierId], references: [id], onDelete: SetNull)
  orders          Order[]
  quotes          Quote[]

  @@index([status])
}

/// Wholesale price level: a discount off retail, optionally overridden per variant.
model PriceTier {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  discountPercent Int /// off retail price
  minOrderValue   Int            @default(0) /// minor units
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        TradeAccount[]
  prices          TradePrice[]
}

model TradePrice {
  tierId    String
  variantId String
  price     Int /// minor units, per unit
  tier      PriceTier      @relation(fields: [tierId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([tierId, variantId])
}

enum QuoteStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Request for quotation: very large, custom or private-label orders.
model Quote {
  id             String       @id @default(cuid())
  number         String       @unique /// Q-26001
  tradeAccountId String
  status         QuoteStatus  @default(REQUESTED)
  message        String?
  staffNotes     String? /// internal
  replyMessage   String? /// shown to the buyer with the quote
  validUntil     DateTime?
  orderId        String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tradeAccount   TradeAccount @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
}

model QuoteItem {
  id             String          @id @default(cuid())
  quoteId        String
  variantId      String?
  description    String /// product label, or free text for custom/private-label requests
  quantity       Int
  targetPrice    Int? /// buyer's target per unit (minor)
  quotedPrice    Int? /// our price per unit (minor)
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────── Atelier / factory visits ───────────────────────────────

enum VisitStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

model Visit {
  id           String      @id @default(cuid())
  reference    String      @unique /// V-26-0001, printed on the visitor pass
  /// Secret for the visitor's self-service link (view / reschedule / cancel)
  token        String      @unique @default(cuid())
  name         String
  email        String
  phone        String
  company      String?
  purpose      String /// WHOLESALE | CORPORATE | WORKSHOP | PRESS | TOUR | OTHER
  groupSize    Int
  startsAt     DateTime
  durationMins Int         @default(60)
  status       VisitStatus @default(REQUESTED)
  message      String?
  staffNotes   String?
  checkedInAt  DateTime?
  userId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([status])
}

// ─────────────────────────────── Returns & exchanges (RMA) ───────────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  EXCHANGED
  REJECTED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  OPENED
}

/// Customer return / exchange request against a delivered order. Policy lives in Setting "returns".
model ReturnRequest {
  id              String            @id @default(cuid())
  number          String            @unique /// RMA-26001
  orderId         String
  userId          String?
  status          ReturnStatus      @default(REQUESTED)
  reason          String
  customerNote    String?
  /// Internal; never shown to the customer
  staffNote       String?
  /// Shown to (and emailed to) the customer when rejected
  rejectionReason String?
  /// What the customer asked for; staff confirm or change it when resolving
  preferred       ReturnResolution  @default(REFUND)
  resolution      ReturnResolution?
  /// Money value given back (refund or store credit), minor units, after the restocking fee
  refundAmount    Int?
  restockingFee   Int               @default(0)
  /// Part of refundAmount refunded against the original payment (via the provider, or by hand for COD/invoice); the rest went back to the gift card
  providerAmount  Int               @default(0)
  /// PROVIDER | MANUAL | GIFT_CARD | STORE_CREDIT | MIXED
  refundMethod    String?
  /// Store credit issued for this return
  giftCardId      String?           @unique
  /// Zero-value replacement order for exchanges
  exchangeOrderId String?           @unique
  requestedAt     DateTime          @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  receivedAt      DateTime?
  resolvedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           ReturnItem[]

  @@index([status, createdAt])
  @@index([orderId])
  @@index([userId])
}

model ReturnItem {
  id          String           @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  /// Recorded on inspection
  condition   ReturnCondition?
  /// Whether the units went back into sellable stock
  restock     Boolean          @default(false)
  returnReq   ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}
